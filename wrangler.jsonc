{
  "name": "nityaacadeny-btp",
  "main": "worker.ts",
  "compatibility_date": "2026-09-20",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nitya-academy-db",
      "database_id": "742bd52d-4c17-4b36-af7c-053a80c52ff6"
    }
  ],
  "previews": {
    "vars": {
      "STAFF_SUBMISSIONS_ENABLED": "false",
      "STAFF_PHOTO_UPLOADS_ENABLED": "true"
    },
    "d1_databases": [
      {
        "binding": "DB",
        "database_name": "nitya-academy-staff-test-db",
        "database_id": "e05ec60a-421b-4283-8ed6-2dcbcb5a1c11"
      }
    ]
  },
  "triggers": {
    "crons": [
      "15 3 * * *"
    ]
  }
}
